# Copy this file to .env and fill in secrets before running docker-compose

# PostgreSQL
POSTGRES_DB=applyflow
POSTGRES_USER=applyflow
POSTGRES_PASSWORD=applyflow123

# JWT (required — use a random 64-char string in production)
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=14

# Google OAuth (optional — set to disabled to skip)
GOOGLE_CLIENT_ID=disabled
GOOGLE_CLIENT_SECRET=disabled
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# OpenAI (required for AI features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Application URLs
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1

# RabbitMQ
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Mail (optional — leave blank to disable email sending)
MAIL_FROM=no-reply@applyflow.ai
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
