# Copy this file to .env and fill in secrets before running docker-compose
# Database
MYSQL_DATABASE=applyflow
MYSQL_USER=applyflow
MYSQL_PASSWORD=applyflow123
MYSQL_ROOT_PASSWORD=root123

# JWT (generate a secure secret for production - must be 32+ chars)
JWT_SECRET=change-this-secret-to-a-long-random-string-with-32-chars-minimum-for-production-use-only
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=14

# Google OAuth (optional, for OAuth login - leave empty for local dev)
GOOGLE_CLIENT_ID=disabled
GOOGLE_CLIENT_SECRET=disabled
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# OpenAI (optional, leave empty for local dev)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# External URLs
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1

# RabbitMQ credentials
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Mail
MAIL_FROM=no-reply@applyflow.ai

# Spring profiles (dev for local, prod for docker)
SPRING_PROFILES_ACTIVE=prod

# Server
SERVER_PORT=8080

# Database connection (docker-compose network service name)
DATABASE_URL=jdbc:mysql://mysql:3306/applyflow?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=applyflow
DATABASE_PASSWORD=applyflow123

# Redis (docker-compose network service name)
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ (docker-compose network service name)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
